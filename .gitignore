# drivers/ is registered as a git submodule pointing at
# https://github.com/tikuos/drivers.git — no gitignore entry needed.

# LaTeX stray logs
texput.log

# Vendored third-party libraries / scratch (not part of the upstream tree)
temp/

# Local hardware reference library: vendor datasheets, board schematics and
# hardware user guides.  Not our work, several are redistribution-restricted,
# and they are large -- see hardware/README.md for the index and for the
# wrong-board trap it exists to prevent.
hardware/

# Scratch demos — not yet promoted into examples/. Will move once
# stable and the dependencies (ARP cache, DHCP wire-up) are public.
demos/

# Closed-source overlay (proprietary drivers, captures, prop demos).
# Anything under prop/ stays out of the public repo.
prop/

# Paper drafts (unpublished)
paper/

# Separate repos
homepage/
examples/
presentation/
academic/
TikuBench/
kintsugi/
docs/
ignored/
tikuConsole/

# applications/tracker is its own repo (https://github.com/tikuos/tracker.git)
# cloned in place, not a submodule -- so it must stay out of this index.  Left
# untracked instead, `git add -A` records it as a bare gitlink with no
# .gitmodules entry, and it clones as an empty directory for everyone else.
applications/

# Python bytecode cache
__pycache__/
insight/

# nRF54L15 CRACEN PK hardware ECDSA: the user's LICENSED BA414EP microcode
# (Nordic-proprietary). TikuOS ships none; drop your own here to opt into
# hardware PK (TIKU_CRACEN_PK_ENABLE=1). Never committed.
arch/nordic/cracen_pk_microcode.h

# Bench experiments: raw captures, scratch scripts and working notes.
# Local lab output, never committed -- findings graduate into kintsugi/ decks
# or TikuBench suites, and the raw data stays here.
experiments/

# Local process tooling: comment/commit style rules, their checkers and the
# commit-msg hook.  House convention for this working copy, not part of the
# OS, so a clone of TikuOS carries no opinion about how to write a commit.
hygiene/
.main-elf-mcu
