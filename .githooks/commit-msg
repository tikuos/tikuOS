# The nested repos (TikuBench, tikukits, kintsugi) share this hook through
# tools/install_hooks.sh, so find the checker from this file rather than from
# the repo being committed to.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
checker="$hook_dir/../tools/check_commit_msg.py"

[ -x "$checker" ] || exit 0
exec "$checker" "$1"
